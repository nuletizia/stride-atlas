# Copy to .env.local and fill in. .env.local is gitignored.
#
# Strava API credentials — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Where Strava sends the user after they authorize. Must exactly match the
# Authorization Callback Domain registered on your Strava app (the domain part).
# Dev:  http://localhost:3000/api/auth/strava/callback
# Prod: https://<your-vercel-domain>/api/auth/strava/callback
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/strava/callback

# Random 32+ char string used to encrypt the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Your app's public URL (used when building redirect-back URLs).
# Dev:  http://localhost:3000
# Prod: https://<your-vercel-domain>
PUBLIC_APP_URL=http://localhost:3000
